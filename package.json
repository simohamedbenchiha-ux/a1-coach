{
  "name": "a1-coach",
  "version": "1.4.0",
  "private": true,
  "description": "A1 Coach : entraînement à l'examen Start Deutsch 1 (web, Android, iOS).",
  "scripts": {
    "test": "node tests/run.mjs",
    "build": "node scripts/build.mjs",
    "build:app": "node scripts/build-app.mjs",
    "sync": "npm run build:app && npx cap sync",
    "android:apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run sync && cd android && ./gradlew bundleRelease",
    "assets": "capacitor-assets generate --assetPath store/app-icon --android --ios --iconBackgroundColor '#070b1c' --iconBackgroundColorDark '#070b1c' --splashBackgroundColor '#050713' --splashBackgroundColorDark '#050713'"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-speech-recognition": "^8.4.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "playwright": "^1.56.1"
  }
}
